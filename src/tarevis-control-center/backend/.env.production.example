# Copy to .env.production.local. This local file is gitignored and loaded by relay:start.
CONTROL_CENTER_MODE=live
CONTROL_CENTER_HOST=127.0.0.1
CONTROL_CENTER_PORT=8780
CONTROL_CENTER_LOG_LEVEL=info

CONTROL_CENTER_RELAY_ENABLED=true
CONTROL_CENTER_RELAY_URL=wss://api.your-domain.example/agent/connect
CONTROL_CENTER_DEVICE_ID=my-computer
CONTROL_CENTER_DEVICE_TOKEN=replace-with-the-raw-token-from-token-generate
CONTROL_CENTER_RELAY_HEARTBEAT_MS=15000
CONTROL_CENTER_RELAY_OFFLINE_TIMEOUT_MS=45000
CONTROL_CENTER_RELAY_RECONNECT_INITIAL_MS=500
CONTROL_CENTER_RELAY_RECONNECT_MAX_MS=8000
CONTROL_CENTER_RELAY_HANDSHAKE_TIMEOUT_MS=10000

# Optional local integrations. Secrets stay only in this untracked file or a local secret manager.
CONTROL_CENTER_TRAE_ADAPTER=communicate
TRAE_COMMUNICATE_URL=http://127.0.0.1:8766
TRAE_COMMUNICATE_TIMEOUT_MS=35000
TRAE_COMMUNICATE_HEALTH_INTERVAL_MS=5000
# QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_MS=120000
HARNESS_MAX_STEPS=6
