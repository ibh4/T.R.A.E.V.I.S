VITE_CONTROL_CENTER_ADAPTER=live
VITE_CONTROL_CENTER_API_BASE=https://api.example.com/
VITE_CONTROL_CENTER_DEVICE_ID=my-computer
VITE_CONTROL_CENTER_AUTH_MODE=access
