# Public values embedded in the Pages bundle. Never put a device token or API key here.
VITE_CONTROL_CENTER_ADAPTER=live
VITE_CONTROL_CENTER_API_BASE=https://api.your-domain.example/
VITE_CONTROL_CENTER_DEVICE_ID=my-computer
VITE_CONTROL_CENTER_AUTH_MODE=access

# Used only by the PowerShell Pages deployment script.
CONTROL_CENTER_PAGES_PROJECT=tarevis-control-center
